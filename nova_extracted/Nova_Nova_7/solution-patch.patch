diff --git a/test/node/size-limits.js b/test/node/size-limits.js
new file mode 100644
index 0000000..dd7de16
--- /dev/null
+++ b/test/node/size-limits.js
@@ -0,0 +1,107 @@
+'use strict';
+
+const assert = require('assert');
+const getSetup = require('../support/setup');
+const request = require('../support/client');
+
+describe('[node] request size limits', () => {
+  let base;
+
+  before(async () => {
+    const setup = await getSetup();
+    base = setup.uri;
+  });
+
+  it('should expose chainable maxRequestSize and hasSizeError', () => {
+    const request_ = request.post(`${base}/echo`);
+    assert.strictEqual(request_.maxRequestSize(10), request_);
+    assert.strictEqual(request_.hasSizeError(), false);
+  });
+
+  it('should measure send data in bytes and not retry size errors', (done) => {
+    let callbacks = 0;
+    let retries = 0;
+    const request_ = request
+      .post(`${base}/echo`)
+      .send('é')
+      .maxRequestSize(1)
+      .retry(2, () => {
+        retries++;
+        return true;
+      });
+
+    request_.end((error) => {
+      callbacks++;
+      assert(error);
+      assert.strictEqual(error.code, 'ETOOLARGE');
+      assert.strictEqual(callbacks, 1);
+      assert.strictEqual(retries, 0);
+      assert.strictEqual(request_.hasSizeError(), true);
+      done();
+    });
+  });
+
+  it('should allow a body whose byte size equals the limit', () => {
+    return request
+      .post(`${base}/echo`)
+      .maxRequestSize(2)
+      .send('é')
+      .then((response) => {
+        assert.strictEqual(response.status, 200);
+      });
+  });
+
+  it('should measure req.write data in bytes', (done) => {
+    const request_ = request.post(`${base}/echo`).maxRequestSize(2);
+    request_.write('é');
+    request_.write('a');
+
+    request_.end((error) => {
+      assert(error);
+      assert.strictEqual(error.code, 'ETOOLARGE');
+      assert.strictEqual(request_.hasSizeError(), true);
+      done();
+    });
+  });
+
+  it('should enforce multipart Content-Length before upload', (done) => {
+    let uploadProgress = false;
+    const request_ = request
+      .post(`${base}/echo`)
+      .field('value', 'payload')
+      .maxRequestSize(0)
+      .on('progress', (event) => {
+        if (event.direction === 'upload') uploadProgress = true;
+      });
+
+    request_.end((error) => {
+      assert(error);
+      assert.strictEqual(error.code, 'ETOOLARGE');
+      assert.strictEqual(request_.hasSizeError(), true);
+      assert.strictEqual(uploadProgress, false);
+      done();
+    });
+  });
+
+  it('should report response size errors once and not retry them', (done) => {
+    let callbacks = 0;
+    let retries = 0;
+    const request_ = request
+      .get(`${base}/login`)
+      .maxResponseSize(1)
+      .retry(2, () => {
+        retries++;
+        return true;
+      });
+
+    request_.end((error) => {
+      callbacks++;
+      assert(error);
+      assert.strictEqual(error.code, 'ETOOLARGE');
+      assert.strictEqual(callbacks, 1);
+      assert.strictEqual(retries, 0);
+      assert.strictEqual(request_.hasSizeError(), true);
+      done();
+    });
+  });
+});
