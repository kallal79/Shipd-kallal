diff --git a/test/node/size.js b/test/node/size.js
new file mode 100644
index 0000000..31ddd1c
--- /dev/null
+++ b/test/node/size.js
@@ -0,0 +1,68 @@
+'use strict';
+
+const assert = require('node:assert');
+const getSetup = require('../support/setup');
+const request = require('../support/client');
+
+describe('[node] request size limits', () => {
+  let setup;
+  let base;
+
+  before(async () => {
+    setup = await getSetup();
+    base = setup.uri;
+  });
+
+  it('aborts with one callback when maxResponseSize is exceeded', (done) => {
+    const request_ = request
+      .get(`${base}/json`)
+      .buffer(true)
+      .maxResponseSize(1);
+    let callbacks = 0;
+
+    request_.end((error) => {
+      callbacks += 1;
+      assert.equal(error.code, 'ETOOLARGE');
+      assert.equal(request_.hasSizeError(), true);
+      assert.equal(request_._aborted, true);
+
+      setTimeout(() => {
+        assert.equal(callbacks, 1);
+        done();
+      }, 20);
+    });
+  });
+
+  it('aborts with one callback when maxRequestSize is exceeded', (done) => {
+    const request_ = request
+      .post(`${base}/echo`)
+      .maxRequestSize(1)
+      .send(Buffer.from('too large'));
+    let callbacks = 0;
+
+    request_.end((error) => {
+      callbacks += 1;
+      assert.equal(error.code, 'ETOOLARGE');
+      assert.equal(request_.hasSizeError(), true);
+      assert.equal(request_._aborted, true);
+
+      setTimeout(() => {
+        assert.equal(callbacks, 1);
+        done();
+      }, 20);
+    });
+  });
+
+  it('applies maxRequestSize to multipart bodies', (done) => {
+    const request_ = request
+      .post(`${base}/echo`)
+      .maxRequestSize(1)
+      .field('name', 'too large');
+
+    request_.end((error) => {
+      assert.equal(error.code, 'ETOOLARGE');
+      assert.equal(request_.hasSizeError(), true);
+      done();
+    });
+  });
+});
