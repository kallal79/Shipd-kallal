+/**
+ * Maximum size of the request body, in bytes.
+ *
+ * @param {Number} n number of bytes
+ * @return {Request} for chaining
+ * @api public
+ */
+RequestBase.prototype.maxRequestSize = function (n) {
+  if (typeof n !== 'number') {
+    throw new TypeError('Invalid argument');
+  }
+
+  this._maxRequestSize = n;
+  return this;
+};
+
+/**
+ * Check whether this request encountered a request or response size error.
+ *
+ * @return {Boolean}
+ * @api public
+ */
+RequestBase.prototype.hasSizeError = function () {
+  return Boolean(this._sizeError);
+};
+
+/**
+ * Abort the request and invoke its callback with a size error.
+ *
+ * @param {String} type request or response
+ * @return {Error|null}
+ * @api private
+ */
+RequestBase.prototype._handleSizeError = function (type) {
+  if (this._sizeError) {
+    return null;
+  }
+
+  const error = new Error(`Maximum ${type} size reached`);
+  error.code = 'ETOOLARGE';
+  this._sizeError = true;
+  this.abort();
+  this.callback(error);
+  return error;
+};
+
+/**
+ * Check a request body length against the configured maximum.
+ *
+ * @param {Number} length request body length in bytes
+ * @return {Boolean}
+ * @api private
+ */
+RequestBase.prototype._checkRequestSize = function (length) {
+  if (
+    this._maxRequestSize !== undefined &&
+    length > this._maxRequestSize
+  ) {
+    this._handleSizeError('request');
+    return false;
+  }
+
+  return true;
+};
+
