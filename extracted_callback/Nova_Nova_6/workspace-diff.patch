+          if (req.req) req.req.emit('error', new Error('ECONNRESET'));
+        } catch (e) {
+          return done(e);
+        }
+
+        setTimeout(() => {
+          try {
+            assert.equal(callbacks, 1, 'Callback should only be invoked once even with late errors');
+            done();
+          } catch(e) {
+            done(e);
+          }
+        }, 50);
+      }
+    });
+  });
+});
