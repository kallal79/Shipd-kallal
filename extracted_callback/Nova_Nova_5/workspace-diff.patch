+  it('should invoke callback exactly once with an error with code ETOOLARGE on maxResponseSize exceeded', (done) => {
+    let callbacks = 0;
+
+    const req = request
+      .post(`${base}/echo`)
+      .send('x'.repeat(100))
+      .buffer(true);
+    assert.strictEqual(req.maxResponseSize(10), req, 'maxResponseSize() must be chainable');
+
+    req.end((error, res) => {
+      callbacks++;
+      if (callbacks === 1) {
+        try {
+          assert.ok(error, 'Should emit an error');
+          assert.equal(error.code, 'ETOOLARGE');
+          assert.strictEqual(req.hasSizeError(), true, 'hasSizeError() should be true');
+        } catch (err) {
+          return done(err);
+        }
+        setTimeout(() => {
+          try {
+            assert.equal(callbacks, 1, 'Callback should only be invoked once');
+            done();
+          } catch (err) {
+            done(err);
+          }
+        }, 50);
+      }
+    });
+  });
+
+  // Test 2: maxRequestSize exceeded (Node stream) → exactly ONE callback with ETOOLARGE
+  it('should emit exactly once an error with code ETOOLARGE on maxRequestSize exceeded (Node)', (done) => {
+    let callbacks = 0;
+
+    const req = request
+      .post(`${base}/echo`);
+    assert.strictEqual(req.maxRequestSize(5), req, 'maxRequestSize() must be chainable');
+    req.send('1234567890');
+
+    req.end((error, res) => {
+      callbacks++;
+      if (callbacks === 1) {
+        try {
+          assert.ok(error, 'Should emit an error for maxRequestSize');
+          assert.equal(error.code, 'ETOOLARGE');
+          assert.strictEqual(req.hasSizeError(), true, 'hasSizeError() should be true');
+          assert.ok(req.req.aborted || req.req.destroyed || req.aborted, 'Request should be aborted');
+        } catch (err) {
+          return done(err);
+        }
+        setTimeout(() => {
+          try {
+            assert.equal(callbacks, 1, 'Callback should only be invoked once');
+            done();
+          } catch (err) {
+            done(err);
+          }
+        }, 50);
+      }
+    });
+  });
+
+  // Test 3: multipart sends must be routed through _sendMultipartBody prototype method
+  it('should delegate multipart sending to Request.prototype._sendMultipartBody', (done) => {
+    let called = false;
+    const original = request.Request.prototype._sendMultipartBody;
+    assert.ok(original, '_sendMultipartBody should exist on prototype');
+    request.Request.prototype._sendMultipartBody = function (formData) {
+      called = true;
+      return original.call(this, formData);
+    };
+
+    request
+      .post(`${base}/echo`)
+      .field('user[name]', 'tobi')
+      .end((err, res) => {
