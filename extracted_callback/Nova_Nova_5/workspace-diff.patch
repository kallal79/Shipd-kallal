@@ -0,0 +1,141 @@
+const assert = require('assert');
+
+// Mock browser environment
+
+class MockXHR {
+  constructor() {
+    this.upload = {
+      addEventListener: (evt, cb) => {
+        if (evt === 'progress') this._uploadProgress = cb;
+      }
+    };
+    this.listeners = {};
+  }
+  open(method, url) { this.method = method; this.url = url; }
+  setRequestHeader() {}
+  send(data) {
+    if (this._uploadProgress && data && data.length > 5) {
+      // Simulate large payload
+      this._uploadProgress({ direction: 'upload', loaded: data.length, total: data.length });
+    }
+
+    // Simulate download progress
+    setTimeout(() => {
+      if (this.listeners.progress) {
+        this.listeners.progress({ direction: 'download', loaded: 100, total: 100 });
+      }
+    }, 10);
+  }
+  addEventListener(evt, cb) {
+    this.listeners[evt] = cb;
+  }
+  abort() { this._aborted = true; }
+}
+
+describe('Client-side maxRequestSize and maxResponseSize', () => {
+  let request;
+
+  before(() => {
+    global.window = { XMLHttpRequest: MockXHR };
+    global.document = { createElement: () => ({ href: 'http://localhost/' }) };
+    global.location = { protocol: 'http:', host: 'localhost' };
+    const clientPath = require.resolve('../../lib/client.js');
+    delete require.cache[clientPath];
+    request = require('../../lib/client.js');
+  });
+
+  after(() => {
+    delete global.window;
+    delete global.document;
+    delete global.location;
+  });
+
+  it('should abort and emit exactly once an error with code ETOOLARGE if payload exceeds maxRequestSize', (done) => {
+    const req = request.post('http://localhost/upload');
+    assert.strictEqual(req.maxRequestSize(5), req, 'maxRequestSize() must be chainable');
+    req.send('1234567890');
+
+    let callbacks = 0;
+    req.end((err, res) => {
+      callbacks++;
+      if (callbacks === 1) {
+        try {
+          assert.ok(err, 'Expected an error');
+          assert.equal(err.code, 'ETOOLARGE');
+          assert.strictEqual(req.hasSizeError(), true, 'hasSizeError() should be true');
+          assert.strictEqual(req.xhr._aborted, true, 'XHR should be aborted');
+        } catch (e) {
+          return done(e);
+        }
+        setTimeout(() => {
+          try {
+            assert.equal(callbacks, 1, 'Callback should only be invoked once');
+            done();
+          } catch(e) {
+            done(e);
+          }
+        }, 20);
+      }
+    });
+  });
+
+  it('should abort and emit ETOOLARGE if response exceeds maxResponseSize', (done) => {
+    const req = request.get('http://localhost/download');
+    assert.strictEqual(req.maxResponseSize(50), req, 'maxResponseSize() must be chainable');
+
+    let callbacks = 0;
+    req.end((err, res) => {
+      callbacks++;
+      if (callbacks === 1) {
+        try {
+          assert.ok(err, 'Expected an error');
+          assert.equal(err.code, 'ETOOLARGE');
+          assert.strictEqual(req.hasSizeError(), true, 'hasSizeError() should be true');
+          assert.strictEqual(req.xhr._aborted, true, 'XHR should be aborted');
+        } catch (e) {
+          return done(e);
+        }
+        setTimeout(() => {
+          try {
+            assert.equal(callbacks, 1, 'Callback should only be invoked once');
+            done();
+          } catch(e) {
+            done(e);
+          }
+        }, 20);
+      }
+    });
+  });
+
+  it('should not double-callback if network error occurs after maxRequestSize abort', (done) => {
+    const req = request.post('http://localhost/upload');
+    req.maxRequestSize(5);
+
+    req.send('1234567890');
+    let callbacks = 0;
+    req.end((err, res) => {
+      callbacks++;
+      if (callbacks === 1) {
+        try {
+          assert.ok(err, 'Expected an error');
+          assert.equal(err.code, 'ETOOLARGE');
+
+          // Simulate late network error from aborted socket
+          if (req.xhr.listeners && req.xhr.listeners.error) {
+            req.xhr.listeners.error(new Error('Late network error'));
+          }
+        } catch (e) {
+          return done(e);
+        }
+        setTimeout(() => {
+          try {
+            assert.equal(callbacks, 1, 'Callback should only be invoked once even with late errors');
+            done();
+          } catch(e) {
+            done(e);
+          }
+        }, 20);
+      }
+    });
+  });
+});
