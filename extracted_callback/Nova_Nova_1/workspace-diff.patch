+      .maxRequestSize(5);
+
+    req.send('1234567890');
+    req.end((error, res) => {
+      callbacks++;
+      if (callbacks === 1) {
+        try {
+          assert.equal(error.code, 'ETOOLARGE');
+          // Simulate late socket error
+          if (req.req) req.req.emit('error', new Error('ECONNRESET'));
+        } catch (e) {
+          return done(e);
+        }
+
+        setTimeout(() => {
+          try {
