diff --git a/test/node/size.js b/test/node/size.js
new file mode 100644
index 0000000..5e5321b
--- /dev/null
+++ b/test/node/size.js
@@ -0,0 +1,78 @@
+'use strict';
+
+const assert = require('assert');
+const getSetup = require('../support/setup');
+const request = require('../support/client');
+
+describe('[node] request and response size limits', () => {
+  let base;
+
+  before(async () => {
+    const setup = await getSetup();
+    base = setup.uri;
+  });
+
+  it('reports one response size error', (done) => {
+    const request_ = request.get(`${base}/ok`).maxResponseSize(1);
+    let callbackCount = 0;
+
+    request_.end((error) => {
+      callbackCount++;
+      assert.strictEqual(error.code, 'ETOOLARGE');
+      assert.strictEqual(request_.hasSizeError(), true);
+      assert.strictEqual(callbackCount, 1);
+      done();
+    });
+  });
+
+  it('counts multibyte buffered request bodies by bytes', (done) => {
+    const request_ = request
+      .post(`${base}/echo`)
+      .maxRequestSize(3)
+      .send('😀');
+
+    request_.end((error) => {
+      assert.strictEqual(error.code, 'ETOOLARGE');
+      assert.strictEqual(request_.hasSizeError(), true);
+      done();
+    });
+  });
+
+  it('limits buffered buffers', (done) => {
+    const request_ = request
+      .post(`${base}/echo`)
+      .maxRequestSize(2)
+      .send(Buffer.from('abc'));
+
+    request_.end((error) => {
+      assert.strictEqual(error.code, 'ETOOLARGE');
+      assert.strictEqual(request_.hasSizeError(), true);
+      done();
+    });
+  });
+
+  it('limits chunked request writes', (done) => {
+    const request_ = request.post(`${base}/echo`).maxRequestSize(3);
+    request_.write('ab');
+    request_.write('cd');
+
+    request_.end((error) => {
+      assert.strictEqual(error.code, 'ETOOLARGE');
+      assert.strictEqual(request_.hasSizeError(), true);
+      done();
+    });
+  });
+
+  it('limits multipart request bodies', (done) => {
+    const request_ = request
+      .post(`${base}/echo`)
+      .maxRequestSize(1)
+      .field('name', 'tobi');
+
+    request_.end((error) => {
+      assert.strictEqual(error.code, 'ETOOLARGE');
+      assert.strictEqual(request_.hasSizeError(), true);
+      done();
+    });
+  });
+});
