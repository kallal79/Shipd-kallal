diff --git a/test/node/size.js b/test/node/size.js
new file mode 100644
index 0000000..06f2dd4
--- /dev/null
+++ b/test/node/size.js
@@ -0,0 +1,136 @@
+'use strict';
+
+const assert = require('assert');
+const getSetup = require('../support/setup');
+const request = require('../support/client');
+
+describe('request and response size limits', () => {
+  let setup;
+  let base;
+
+  before(async () => {
+    setup = await getSetup();
+    base = setup.uri;
+  });
+
+  it('uses bytes, allows an exact request size, and is chainable', () => {
+    const request_ = request
+      .post(`${base}/echo`)
+      .type('text')
+      .maxRequestSize(2)
+      .send('é');
+
+    assert.strictEqual(request_.maxRequestSize(2), request_);
+    assert.strictEqual(request_.hasSizeError(), false);
+
+    return request_.then((res) => {
+      assert.strictEqual(res.text, 'é');
+      assert.strictEqual(request_.hasSizeError(), false);
+    });
+  });
+
+  it('rejects an oversized send with ETOOLARGE', () => {
+    const request_ = request
+      .post(`${base}/echo`)
+      .type('text')
+      .maxRequestSize(2)
+      .retry(2, () => assert.fail('size errors must not retry'))
+      .send('éa');
+
+    return request_.then(
+      () => assert.fail('expected a size error'),
+      (error) => {
+        assert.strictEqual(error.code, 'ETOOLARGE');
+        assert.strictEqual(request_.hasSizeError(), true);
+      }
+    );
+  });
+
+  it('limits req.write() by UTF-8 byte length', (done) => {
+    const request_ = request
+      .post(`${base}/echo`)
+      .type('text')
+      .maxRequestSize(2);
+    let callbackCount = 0;
+
+    request_.write('é');
+    assert.strictEqual(request_.write('a'), false);
+    request_.end((error) => {
+      callbackCount++;
+      try {
+        assert.strictEqual(error.code, 'ETOOLARGE');
+        assert.strictEqual(callbackCount, 1);
+        assert.strictEqual(request_.hasSizeError(), true);
+        done();
+      } catch (err) {
+        done(err);
+      }
+    });
+  });
+
+  it('uses multipart Content-Length and emits upload progress', (done) => {
+    const request_ = request
+      .post(`${base}/echo`)
+      .attach('document', 'test/node/fixtures/user.html');
+    let lastProgress;
+
+    request_._formData.getLength((lengthError, length) => {
+      if (lengthError) return done(lengthError);
+      request_
+        .maxRequestSize(length)
+        .on('progress', (event) => {
+          if (event.direction === 'upload') lastProgress = event;
+        })
+        .end((error) => {
+          try {
+            assert.ifError(error);
+            assert.strictEqual(lastProgress.loaded, length);
+            assert.strictEqual(lastProgress.total, length);
+            assert.strictEqual(request_.hasSizeError(), false);
+            done();
+          } catch (err) {
+            done(err);
+          }
+        });
+      });
+  });
+
+  it('rejects oversized multipart Content-Length before uploading', (done) => {
+    const request_ = request
+      .post(`${base}/echo`)
+      .attach('document', 'test/node/fixtures/user.html');
+
+    request_._formData.getLength((lengthError, length) => {
+      if (lengthError) return done(lengthError);
+      request_.maxRequestSize(length - 1).end((error) => {
+        try {
+          assert.strictEqual(error.code, 'ETOOLARGE');
+          assert.strictEqual(request_.hasSizeError(), true);
+          done();
+        } catch (err) {
+          done(err);
+        }
+      });
+    });
+  });
+
+  it('reports a response size error once and never retries it', (done) => {
+    const request_ = request
+      .get(`${base}/binary-data`)
+      .maxResponseSize(1)
+      .retry(2, () => assert.fail('size errors must not retry'));
+    let callbackCount = 0;
+
+    request_.end((error) => {
+      callbackCount++;
+      try {
+        assert.strictEqual(error.code, 'ETOOLARGE');
+        assert.strictEqual(callbackCount, 1);
+        assert.strictEqual(request_.hasSizeError(), true);
+        done();
+      } catch (err) {
+        done(err);
+      }
+    });
+  });
+});
