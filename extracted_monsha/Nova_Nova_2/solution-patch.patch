diff --git a/test/node/size-limits.js b/test/node/size-limits.js
new file mode 100644
index 0000000..ddadfd8
--- /dev/null
+++ b/test/node/size-limits.js
@@ -0,0 +1,105 @@
+'use strict';
+
+const assert = require('assert');
+const getSetup = require('../support/setup');
+const request = require('../support/client');
+
+describe('request size limits', () => {
+  let base;
+
+  before(async () => {
+    const setup = await getSetup();
+    base = setup.uri;
+  });
+
+  it('counts request body bytes and allows the exact limit', async () => {
+    const req = request
+      .post(`${base}/echo`)
+      .maxRequestSize(2)
+      .type('text/plain')
+      .send('é');
+
+    const res = await req;
+    assert.equal(res.text, 'é');
+    assert.equal(req.hasSizeError(), false);
+  });
+
+  it('returns ETOOLARGE for an oversized send body', (done) => {
+    const req = request
+      .post(`${base}/echo`)
+      .maxRequestSize(1)
+      .type('text/plain')
+      .send('é');
+
+    req.end((error) => {
+      assert.equal(error.code, 'ETOOLARGE');
+      assert.equal(req.hasSizeError(), true);
+      done();
+    });
+  });
+
+  it('counts bytes written through req.write()', (done) => {
+    const req = request.post(`${base}/echo`).maxRequestSize(2);
+    assert.equal(req.write('é'), true);
+    assert.equal(req.write('a'), false);
+
+    req.end((error) => {
+      assert.equal(error.code, 'ETOOLARGE');
+      assert.equal(req.hasSizeError(), true);
+      done();
+    });
+  });
+
+  it('does not retry a response size error or call back twice', (done) => {
+    let retryCount = 0;
+    const req = request
+      .get(`${base}/json`)
+      .maxResponseSize(1)
+      .retry(2, () => {
+        retryCount++;
+        return true;
+      });
+    let callbackCount = 0;
+
+    req.end((error) => {
+      callbackCount++;
+      assert.equal(error.code, 'ETOOLARGE');
+      assert.equal(req.hasSizeError(), true);
+      setImmediate(() => {
+        assert.equal(callbackCount, 1);
+        assert.equal(retryCount, 0);
+        done();
+      });
+    });
+  });
+
+  it('enforces multipart Content-Length and reports upload progress', async () => {
+    const req = request
+      .post(`${base}/echo`)
+      .field('name', 'Tobi');
+    const length = await new Promise((resolve, reject) => {
+      req._formData.getLength((error, value) => {
+        if (error) reject(error);
+        else resolve(value);
+      });
+    });
+    const progress = [];
+    req
+      .maxRequestSize(length)
+      .on('progress', (event) => progress.push(event));
+
+    await req;
+    assert.equal(req.hasSizeError(), false);
+    assert(progress.some((event) => event.direction === 'upload'));
+
+    const oversized = request
+      .post(`${base}/echo`)
+      .field('name', 'Tobi')
+      .maxRequestSize(length - 1);
+    const error = await new Promise((resolve) => {
+      oversized.end(resolve);
+    });
+    assert.equal(error.code, 'ETOOLARGE');
+    assert.equal(oversized.hasSizeError(), true);
+  });
+});
