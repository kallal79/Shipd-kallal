+
+  // T20: Browser readyState 1 non-settlement and readyState 4 completion
+  it('should not settle browser request at readyState 1 and complete normally at readyState 4', (done) => {
+    const EventEmitter = require('events');
+    const clientRequest = require('../../src/client');
+
+    class MockXHR extends EventEmitter {
+      constructor() {
+        super();
+        this.readyState = 0;
+        this.status = 0;
+        this.headers = {};
+        this.upload = new EventEmitter();
+        this.responseHeaders = {};
+      }
+      open(method, url) {
+        this.method = method;
+        this.url = url;
+        this.readyState = 1;
+        this.emit('readystatechange');
+      }
+      setRequestHeader(name, val) { this.headers[name] = val; }
+      getResponseHeader(name) { return this.responseHeaders[name.toLowerCase()] || null; }
+      getAllResponseHeaders() {
+        return Object.entries(this.responseHeaders).map(([k, v]) => `${k}: ${v}`).join('\r\n') + '\r\n';
+      }
+      send(data) { this.sentData = data; }
+      abort() { this.aborted = true; }
+      addEventListener(event, fn) { this.on(event, fn); }
+    }
+
+    const mock = new MockXHR();
+    clientRequest.getXHR = () => mock;
+    let called = false;
+    const req = clientRequest('GET', '/test').maxResponseSize(10);
+    assert.strictEqual(typeof req.hasSizeError, 'function');
+    req.end((err, res) => {
+      called = true;
+      try {
+        assert.strictEqual(err, null);
+        assert.ok(res && res.status === 200);
+        done();
+      } catch (e) {
+        done(e);
+      }
+    });
+    assert.strictEqual(called, false, 'Browser request must NOT settle or fail at readyState 1');
+    mock.readyState = 4;
+    mock.status = 200;
+    mock.response = 'ok';
+    mock.responseText = 'ok';
+    mock.emit('readystatechange');
+  });
+
+  // T21: Browser maxResponseSize on progress
+  it('should emit ETOOLARGE on browser response download progress overflow', (done) => {
+    const EventEmitter = require('events');
+    const clientRequest = require('../../src/client');
+
+    class MockXHR extends EventEmitter {
+      constructor() {
+        super();
+        this.readyState = 0;
+        this.status = 0;
+        this.headers = {};
+        this.upload = new EventEmitter();
+      }
+      open() { this.readyState = 1; }
+      setRequestHeader() {}
+      getResponseHeader() { return null; }
+      getAllResponseHeaders() { return ''; }
+      send() {}
+      abort() { this.aborted = true; }
+      addEventListener(event, fn) { this.on(event, fn); }
+    }
+
+    const mock = new MockXHR();
+    clientRequest.getXHR = () => mock;
+    const req = clientRequest('GET', '/large').maxResponseSize(5);
+    req.end((err) => {
+      try {
+        assert.ok(err, 'Should produce error');
+        assert.equal(err.code, 'ETOOLARGE');
+        assert.strictEqual(req.hasSizeError(), true);
+        done();
+      } catch (e) {
+        done(e);
+      }
+    });
+    mock.emit('progress', { direction: 'download', loaded: 10, total: 10 });
+  });
+
+  // T22: Browser maxRequestSize overflow
+  it('should emit ETOOLARGE on browser request send overflow', (done) => {
+    const EventEmitter = require('events');
+    const clientRequest = require('../../src/client');
+
+    class MockXHR extends EventEmitter {
+      constructor() {
+        super();
+        this.readyState = 0;
+        this.status = 0;
+        this.headers = {};
+        this.upload = new EventEmitter();
+      }
+      open() { this.readyState = 1; }
+      setRequestHeader() {}
+      getResponseHeader() { return null; }
+      getAllResponseHeaders() { return ''; }
+      send() {}
+      abort() { this.aborted = true; }
+      addEventListener(event, fn) { this.on(event, fn); }
+    }
+
+    const mock = new MockXHR();
+    clientRequest.getXHR = () => mock;
+    const req = clientRequest('POST', '/send').maxRequestSize(5).send('1234567890');
+    req.end((err) => {
+      try {
+        assert.ok(err, 'Should produce error');
+        assert.equal(err.code, 'ETOOLARGE');
+        assert.strictEqual(req.hasSizeError(), true);
+        done();
+      } catch (e) {
+        done(e);
+      }
+    });
+  });
+
+  // T23: JSON object payload sizing
+  it('should measure byte length for JSON object payload in maxRequestSize', (done) => {
+    const payload = { "hello": "world", "multibyte": "€" };
+    const payloadStr = JSON.stringify(payload);
+    const byteLength = Buffer.byteLength(payloadStr);
+
+    request
+      .post(`${base}/echo`)
+      .maxRequestSize(byteLength - 1)
