diff --git a/test/node/size-limit.js b/test/node/size-limit.js
new file mode 100644
index 0000000..3408e2f
--- /dev/null
+++ b/test/node/size-limit.js
@@ -0,0 +1,157 @@
+'use strict';
+
+const assert = require('assert');
+const getSetup = require('../support/setup');
+const request = require('../support/client');
+
+describe('request and response size limits', () => {
+  let base;
+
+  before(async () => {
+    ({ uri: base } = await getSetup());
+  });
+
+  it('has a chainable maxRequestSize and a strict hasSizeError result', () => {
+    const request_ = request.post(`${base}/echo`);
+    assert.strictEqual(request_.maxRequestSize(2), request_);
+    assert.strictEqual(request_.hasSizeError(), false);
+    assert.strictEqual(typeof request_.hasSizeError(), 'boolean');
+  });
+
+  it('counts encoded bytes for send and permits the exact limit', (done) => {
+    const request_ = request
+      .post(`${base}/echo`)
+      .type('text/plain')
+      .maxRequestSize(2)
+      .send('é');
+
+    request_.end((error, response) => {
+      try {
+        assert.ifError(error);
+        assert.strictEqual(response.text, 'é');
+        assert.strictEqual(request_.hasSizeError(), false);
+        done();
+      } catch (err) {
+        done(err);
+      }
+    });
+  });
+
+  it('limits req.write bytes before writing an over-sized chunk', (done) => {
+    const request_ = request.post(`${base}/echo`).maxRequestSize(2);
+    assert.strictEqual(request_.write('é'), true);
+    assert.strictEqual(request_.write('a'), false);
+
+    request_.end((error) => {
+      try {
+        assert(error);
+        assert.strictEqual(error.code, 'ETOOLARGE');
+        assert.strictEqual(request_.hasSizeError(), true);
+        done();
+      } catch (err) {
+        done(err);
+      }
+    });
+  });
+
+  it('does not retry a request size error', (done) => {
+    let retries = 0;
+    const request_ = request
+      .post(`${base}/echo`)
+      .maxRequestSize(1)
+      .retry(2, () => {
+        retries++;
+      })
+      .send('too large');
+
+    request_.end((error) => {
+      try {
+        assert(error);
+        assert.strictEqual(error.code, 'ETOOLARGE');
+        assert.strictEqual(error.retries, 0);
+        assert.strictEqual(retries, 0);
+        done();
+      } catch (err) {
+        done(err);
+      }
+    });
+  });
+
+  it('reports one response size error and does not retry it', (done) => {
+    let calls = 0;
+    let retries = 0;
+    const request_ = request
+      .post(`${base}/echo`)
+      .maxResponseSize(1)
+      .retry(2, () => {
+        retries++;
+      })
+      .send('ok');
+
+    request_.end((error) => {
+      calls++;
+      try {
+        assert(error);
+        assert.strictEqual(error.code, 'ETOOLARGE');
+        assert.strictEqual(error.retries, 0);
+        assert.strictEqual(retries, 0);
+        assert.strictEqual(request_.hasSizeError(), true);
+        setTimeout(() => {
+          try {
+            assert.strictEqual(calls, 1);
+            done();
+          } catch (err) {
+            done(err);
+          }
+        }, 20);
+      } catch (err) {
+        done(err);
+      }
+    });
+  });
+
+  it('checks multipart Content-Length and keeps upload progress', (done) => {
+    const request_ = request
+      .post(`${base}/echo`)
+      .field('name', 'Tobi');
+    let progress = false;
+
+    request_._formData.getLength((lengthError, length) => {
+      if (lengthError) return done(lengthError);
+
+      request_
+        .maxRequestSize(length)
+        .on('progress', (event) => {
+          if (event.direction === 'upload') progress = true;
+        })
+        .end((error) => {
+          try {
+            assert.ifError(error);
+            assert.strictEqual(progress, true);
+            assert.strictEqual(request_.hasSizeError(), false);
+            done();
+          } catch (err) {
+            done(err);
+          }
+        });
+    });
+  });
+
+  it('rejects multipart data when Content-Length exceeds the limit', (done) => {
+    const request_ = request
+      .post(`${base}/echo`)
+      .field('name', 'Tobi')
+      .maxRequestSize(0);
+
+    request_.end((error) => {
+      try {
+        assert(error);
+        assert.strictEqual(error.code, 'ETOOLARGE');
+        assert.strictEqual(request_.hasSizeError(), true);
+        done();
+      } catch (err) {
+        done(err);
+      }
+    });
+  });
+});
